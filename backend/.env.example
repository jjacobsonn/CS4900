# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vellum
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Optional (Render / Heroku): paste Internal or External Postgres URL once.
# If set, DB_HOST / DB_USER / etc. are ignored by the API pool.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_INTERNAL_URL=postgresql://...
# DB_SSL=true

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT (required for login and all protected API routes)
JWT_SECRET=your_jwt_secret_key_here
# Optional; e.g. 8h, 7d (see jsonwebtoken expiresIn)
# JWT_EXPIRES_IN=24h

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
