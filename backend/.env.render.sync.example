# Copy to backend/.env.render.sync (gitignored) and fill the password.
# Use External Postgres host (…oregon-postgres.render.com), not the short Internal host.
#
#   cp backend/.env.render.sync.example backend/.env.render.sync
#
# Then from repo root:
#   npm run db:render:sync

TARGET_DB_HOST=dpg-xxxxxxxx.oregon-postgres.render.com
TARGET_DB_PORT=5432
TARGET_DB_NAME=vellum_postgres
TARGET_DB_USER=vellum_postgres_user
TARGET_DB_PASSWORD=
TARGET_DB_SSLMODE=require
