{
  "name": "vellum-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "db:setup": "node scripts/db-setup.mjs",
    "db:reset": "node scripts/db-setup.mjs --reset",
    "db:sync": "npm run db:reset",
    "db:migrate": "node scripts/db-setup.mjs --migrations-only",
    "db:deploy": "npm run db:migrate",
    "db:snapshot:export": "node scripts/db-snapshot-export.mjs",
    "db:snapshot:import": "node scripts/db-snapshot-import.mjs",
    "db:snapshot:ship": "node scripts/db-snapshot-ship.mjs",
    "migrate": "npm run db:deploy",
    "init-db": "npm run db:setup",
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "start": "concurrently \"npm run start -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:backend": "npm run test -w backend",
    "test:frontend": "npm run test -w frontend",
    "build": "npm run build -w frontend",
    "build:frontend": "npm run build -w frontend",
    "start:backend": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
